{
  "manifest_version": 2,
  "name": "Tsukkomi Quick Note",
  "version": "1.1.0",
  "description": "Quick note-taking extension for Tsukkomi. Save memos from any webpage with one click.",
  "author": "mao",
  "homepage_url": "https://tsukkomi.lain.today",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "browser_action": {
    "default_icon": "icons/icon48.png",
    "default_popup": "popup/popup.html",
    "default_title": "Tsukkomi Quick Note"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tsukkomi-quick-note@lain.today",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
